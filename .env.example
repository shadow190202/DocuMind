# ============================================================
# DOCUMIND - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in the values
# ============================================================

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (Clerk - Phase 3)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Database (PostgreSQL + pgvector - Phase 4)
DATABASE_URL=postgresql://username:password@localhost:5432/documind

# Storage (Phase 5)
STORAGE_PROVIDER=local
# Optional Cloud Storage: AWS / Supabase / UploadThing
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET_NAME=

# AI & Embedding Providers (Phase 7 & Phase 9)
GEMINI_API_KEY=
# OPENAI_API_KEY=
