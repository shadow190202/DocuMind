# ==============================================================================
# DOCUMIND — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# For production deployment, set these variables in your host or container environment.
# NEVER commit real credentials or .env files to version control.
# ==============================================================================

# ==============================================================================
# 1. PRODUCTION ENVIRONMENT VARIABLES (REQUIRED FOR PRODUCTION DEPLOYMENT)
# ==============================================================================

# Application Base URL (Canonical URL for production; no trailing slash)
NEXT_PUBLIC_APP_URL=https://documind.example.com

# Node & Server Runtime (Default port is 3000)
NODE_ENV=production
PORT=3000

# PostgreSQL Database Connection with pgvector
# Compatible with Neon, Supabase, Railway, or self-hosted PostgreSQL (SSL required in production)
DATABASE_URL=postgresql://user:password@host:5432/documind?sslmode=require

# Clerk Production Authentication
# Use live keys (pk_live_... / sk_live_...) obtained from the Clerk Dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key

# Clerk Routing Configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Optional Clerk Proxy Configuration (for custom domains requiring explicit proxy URL)
# NEXT_PUBLIC_CLERK_PROXY_URL=https://docu-mind-dun.vercel.app/__clerk

# Google Gemini API Key (Free tier)
# Used for gemini-embedding-001 (768 dimensions) and gemini-3.8-flash (chat, summary, compare)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults to gemini-3.8-flash)
# GEMINI_CHAT_MODEL=gemini-3.8-flash

# Document Storage Subsystem
# Options: 'local' (for local development, container volume /app/storage, and offline test suites)
#       or 'vercel-blob' (for serverless Vercel deployments with direct private uploads)
STORAGE_PROVIDER=local
NEXT_PUBLIC_STORAGE_PROVIDER=local

# Vercel Blob Read-Write Token (Required when STORAGE_PROVIDER=vercel-blob)
# Obtain from: Vercel Dashboard -> Storage -> Blob Store -> Settings
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# ==============================================================================
# 2. LOCAL DEVELOPMENT ENVIRONMENT VARIABLES (.env.local ONLY)
# ==============================================================================
# In local development, replace production credentials with development values:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/documind
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# GEMINI_API_KEY=your_development_gemini_api_key

# ==============================================================================
# 3. TESTING-ONLY VARIABLES (STRICTLY FORBIDDEN IN PRODUCTION)
# ==============================================================================
# The following variables are used exclusively by automated test suites.
# WARNING: Do NOT set any of these in production or staging environments!
#
# DOCUMIND_MOCK_AI=true
#   - Enables offline AI transport mocks during unit/integration tests (0 API quota used).
#   - FORBIDDEN in production: Real Gemini API calls are required in production.
#
# DOCUMIND_E2E_MODE=enabled
#   - Enables synthetic authentication bypass strictly for local Playwright browser tests.
#   - FORBIDDEN in production: Omitting this ensures synthetic auth is physically impossible in production.
#
# DOCUMIND_E2E_SECRET=your_test_secret_min_16_characters
#   - Shared HMAC secret for verifying synthetic E2E test cookies.
#   - FORBIDDEN in production.
# ==============================================================================
